[Unit]
Description=Swarm run %i
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/Repos/swarm
ExecStart=%h/.local/bin/uv run --project %h/Desktop/Repos/swarm swarm run %i
Restart=on-failure
RestartSec=60
KillMode=mixed
TimeoutStopSec=90

[Install]
WantedBy=default.target
