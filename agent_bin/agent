#!/usr/bin/env python3
"""agent: list agents, or create a new one."""

import json
import os
import sys
import time
from pathlib import Path

AGENTS = Path("/swarm/agents.json")
OUTBOX = Path(os.environ.get("HOME", ".")) / ".outbox" / "ops.jsonl"

HELP = """\
agent list                  who exists, their status and who created them
agent spawn "message"       create a new agent next round ("-" reads the message from stdin).
                            It is identical to you, gets the same seed prompt and the same
                            budget, and starts with your message. Its spending counts
                            toward the run's budget."""


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("help", "-h", "--help"):
        print(HELP)
        return
    if argv[0] == "list":
        if not AGENTS.exists():
            die("no agent list yet")
        data = json.loads(AGENTS.read_text())
        print(f"{data['alive']} alive of at most {data['max_alive']}; "
              f"{data['total']} created of at most {data['max_total']}")
        for a in data["agents"]:
            parent = f"created by {a['parent']}" if a["parent"] else "original"
            print(f"{a['id']}  {a['status']:<9} born round {a['born']:<4} {parent}")
        return
    if argv[0] == "spawn":
        text = " ".join(argv[1:])
        if text == "-":
            text = sys.stdin.read()
        text = text.strip()
        if not text:
            die('usage: agent spawn "message"')
        if len(text) > 8000:
            die("message too long (8000 characters max)")
        OUTBOX.parent.mkdir(parents=True, exist_ok=True)
        line = json.dumps({"op": "spawn", "prompt": text, "time": time.time()}) + "\n"
        fd = os.open(OUTBOX, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o644)
        os.write(fd, line.encode())
        os.close(fd)
        print("queued: the new agent starts next round; you will be told its name")
        return
    die(f"unknown command {argv[0]!r}\n\n{HELP}")


if __name__ == "__main__":
    main()
